PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security Secrets
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=

# AI PROVIDER 1: Gemini Document AI (Medical document processing / OCR / Nirvana Document Analysis)
GEMINI_DOCUMENT_API_KEY=
GEMINI_API_KEY=

# AI PROVIDER 2: Gemini Audio (Audio understanding / Voice / Nirvana Voice Assist)
GEMINI_AUDIO_API_KEY=

# AI PROVIDER 3: Groq (ONLY for clinical conversation, adaptive HPI, and structured summary)
GROQ_API_KEY=

# Optional ABDM Sandbox Configuration (Displays NOT CONNECTED if unconfigured)
